{
  "expo": {
    "name": "Diaa",
    "slug": "diaa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "jordan-electricity",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4965"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jo.cpa.electricity"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C1F3D"
      },
      "edgeToEdgeEnabled": true,
      "package": "jo.cpa.electricity",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-camera",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1487b99-f548-46e4-b9c7-a3466acbafe6"
      }
    },
    "owner": "issadalu"
  }
}
